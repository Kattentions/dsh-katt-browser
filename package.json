{
  "name": "dsh-katt-browser",
  "version": "0.9.70",
  "type": "module",
  "description": "DeepSeek Harness sidebar browser: structure-first page reading (AX tree / DOM / worker / network) plus multi-account cookie snapshots, driven over the Chrome DevTools Protocol.",
  "license": "MIT",
  "author": "Kattentions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kattentions/dsh-katt-browser.git"
  },
  "homepage": "https://github.com/Kattentions/dsh-katt-browser#readme",
  "bugs": {
    "url": "https://github.com/Kattentions/dsh-katt-browser/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "chrome-devtools-protocol",
    "agent",
    "accessibility-tree"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.zh.md",
    "docs/**",
    "scripts/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-contracts.mjs && node scripts/check-boundaries.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare-release": "node scripts/prepare-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js"
}
